# ===========================
# Environment Configuration
# ===========================
# Server Port
PORT=3005
NODE_ENV=development
# Logging level: debug | info | warn | error (default: debug in dev, info in prod)
LOG_LEVEL=debug

# ====================================
# AWS Configuration
# ====================================
AWS_REGION=us-east-1

# S3
AWS_S3_BUCKET=your-s3-bucket-name

# Cognito
AWS_USER_POOL_ID=us-east-1_XXXXXXXXX
AWS_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx

# ====================================
# Database (RDS / PostgreSQL)
# ====================================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=your_db_user
DB_PASSWORD=your_db_password
DB_DATABASE=your_db_name

# ====================================
# PHI Encryption (AES-256-GCM)
# Generate with: openssl rand -hex 32
# ====================================
PHI_ENCRYPTION_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ====================================
# AI / Transcription
# ====================================
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
AI_TRANSCRIBE_URL=http://localhost:5000/transcribe

# ====================================
# CORS (comma-separated origins)
# ====================================
# ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# ====================================
# Audit Logging
# ====================================
# Override default audit log file path (optional)
# AUDIT_LOG_PATH=/var/log/revclear/audit.log
