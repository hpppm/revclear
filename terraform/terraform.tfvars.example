# Copy to terraform.tfvars and fill with your values from .env

environment = "dev"
aws_region  = "us-east-1"

# From .env
bucket_ai_data          = ""  # ${BUCKET_AI}
bucket_terraform_state  = ""  # ${BUCKET_TERRAFORM}
cognito_user_pool_id    = ""  # ${COGNITO_USER_POOL_ID}
sagemaker_role_arn      = ""  # If using SageMaker
