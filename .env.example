# RevClear Environment Variables Template
# Copy this file to .env and fill in your actual AWS values
# NEVER commit .env to git

# ==========================================
# AWS ACCOUNT / REGION
# ==========================================
AWS_ACCOUNT_ID=your-aws-account-id
AWS_REGION=us-east-1

# ==========================================
# NETWORK CONFIG
# ==========================================
VPC_ID=vpc-xxxxx
VPC_CIDR=172.31.0.0/16
IGW_ID=igw-xxxxx
NAT_GATEWAY_ID=nat-xxxxx
NAT_GATEWAY_EIP=x.x.x.x
ROUTE_TABLE_PUBLIC=rtb-xxxxx
ROUTE_TABLE_PRIVATE=rtb-xxxxx

# ==========================================
# SUBNETS
# ==========================================
SUBNET_A=subnet-xxxxx
SUBNET_B=subnet-xxxxx
SUBNET_C=subnet-xxxxx
SUBNET_D=subnet-xxxxx
SUBNET_E=subnet-xxxxx
SUBNET_F=subnet-xxxxx

# ==========================================
# SECURITY GROUPS
# ==========================================
DEFAULT_SG=sg-xxxxx
LAMBDA_SG=sg-xxxxx

# ==========================================
# EC2 WHISPER SERVER (Optional - Consider local instead)
# ==========================================
WHISPER_INSTANCE_ID=i-xxxxx
WHISPER_PUBLIC_IP=x.x.x.x
WHISPER_PRIVATE_IP=172.31.x.x
WHISPER_ENDPOINT=http://172.31.x.x:8080/inference
WHISPER_MODEL=ggml-base.en.bin

# ==========================================
# LAMBDA FUNCTIONS
# ==========================================
LAMBDA_WHISPER_NAME=whisperLambda
LAMBDA_WHISPER_ARN=arn:aws:lambda:REGION:ACCOUNT_ID:function:whisperLambda
LAMBDA_PROCESS_AUDIO_NAME=processAudioLambda
LAMBDA_PROCESS_AUDIO_ARN=arn:aws:lambda:REGION:ACCOUNT_ID:function:processAudioLambda
LAMBDA_TRANSCRIBE_SIMPLE_NAME=transcribeAudioSimple
LAMBDA_GENERATE_CODES_NAME=generateCodesSimple
LAMBDA_ROLE_NAME=LambdaRevclearRole
LAMBDA_ROLE_ARN=arn:aws:iam::ACCOUNT_ID:role/LambdaRevclearRole
LAMBDA_SUBNET_1=subnet-xxxxx
LAMBDA_SUBNET_2=subnet-xxxxx

# ==========================================
# API GATEWAY
# ==========================================
API_ID=xxxxxxxxxx
API_NAME=whisper-secure-api
API_STAGE=prod
API_TRANSCRIBE=https://xxxxxxxxxx.execute-api.REGION.amazonaws.com/prod/transcribe
API_AUTHORIZER_ID=xxxxxx
API_GATEWAY_ID=xxxxxxxxxx
API_GATEWAY_NAME=RevclearTranscribeAPI
API_GATEWAY_STAGE=dev
API_GATEWAY_DEPLOYMENT_ID=xxxxxx
API_GATEWAY_ROOT_RESOURCE_ID=xxxxxxxxxx
API_GATEWAY_TRANSCRIBE_RESOURCE_ID=xxxxxx
API_ENDPOINT=https://xxxxxxxxxx.execute-api.REGION.amazonaws.com/dev

# ==========================================
# COGNITO
# ==========================================
COGNITO_USER_POOL_ID=REGION_xxxxxxxxx
COGNITO_USER_POOL_NAME=ClinicUserPoolSimple
COGNITO_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_IDENTITY_POOL_ID=REGION:xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
COGNITO_IDENTITY_POOL_NAME=ClinicIdentityPool
COGNITO_REGION=us-east-1
COGNITO_GROUP_A=Clinic_A
COGNITO_GROUP_B=Clinic_B
COGNITO_GROUP_C=Clinic_C
COGNITO_USER_1=clinician@example.com

# ==========================================
# IAM ROLES
# ==========================================
ROLE_CLINIC_A=arn:aws:iam::ACCOUNT_ID:role/ClinicARole
ROLE_CLINIC_B=arn:aws:iam::ACCOUNT_ID:role/ClinicBRole
ROLE_CLINIC_C=arn:aws:iam::ACCOUNT_ID:role/ClinicCRole
ROLE_LAMBDA_PROCESSING=arn:aws:iam::ACCOUNT_ID:role/RevClearAIProcessingRole

# ==========================================
# IAM USERS
# ==========================================
IAM_USER_1=user1
IAM_USER_2=user2
IAM_USER_3=user3

# ==========================================
# DYNAMODB TABLES
# ==========================================
DYNAMO_TABLE_MENTAL=mental_health_patients
DYNAMO_TABLE_PHYSICAL=physical_therapy_patients
DYNAMO_TABLE_SPEECH=speech_therapy_patients
DYNAMODB_MENTAL_HEALTH_TABLE=mental_health_patients
DYNAMODB_PHYSICAL_THERAPY_TABLE=physical_therapy_patients
DYNAMODB_SPEECH_THERAPY_TABLE=speech_therapy_patients
DYNAMODB_TERRAFORM_LOCKS_TABLE=revclear-terraform-locks

# ==========================================
# S3 BUCKETS
# ==========================================
BUCKET_GENERAL=your-bucket-name
BUCKET_LOGS=your-bucket-logs
BUCKET_RAW=your-bucket-raw
BUCKET_EXPORTS=your-bucket-exports
BUCKET_AI=your-ai-bucket-ACCOUNT_ID
BUCKET_TERRAFORM=your-terraform-state-ACCOUNT_ID
S3_MAIN_BUCKET=your-bucket-name
S3_EXPORTS_BUCKET=your-bucket-exports
S3_LOGS_BUCKET=your-bucket-logs
S3_RAW_BUCKET=your-bucket-raw
S3_AI_DATA_BUCKET=your-ai-bucket-ACCOUNT_ID
S3_TERRAFORM_STATE_BUCKET=your-terraform-state-ACCOUNT_ID

# ==========================================
# CLOUDTRAIL
# ==========================================
CLOUDTRAIL_NAME=RevClearTrail
CLOUDTRAIL_ARN=arn:aws:cloudtrail:REGION:ACCOUNT_ID:trail/RevClearTrail
CLOUDTRAIL_LOG_BUCKET=your-bucket-logs
CLOUDTRAIL_BUCKET=your-bucket-logs
CLOUDTRAIL_KMS_KEY=arn:aws:kms:REGION:ACCOUNT_ID:key/xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# ==========================================
# AI SERVICES
# ==========================================
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0
TRANSCRIBE_LANGUAGE_CODE=en-US
TRANSCRIBE_SPECIALTY=PRIMARYCARE

# ==========================================
# TENANT/CLINIC FOLDERS (in S3)
# ==========================================
CLINIC_A_FOLDER=clinicA/
CLINIC_B_FOLDER=clinicB/
CLINIC_C_FOLDER=clinicC/

# ==========================================
# PROJECT SETTINGS
# ==========================================
PROJECT_NAME=revclear
ENVIRONMENT=dev
LOG_LEVEL=info

# ==========================================
# FRONTEND
# ==========================================
FRONTEND_URL=https://your-bucket.s3.amazonaws.com/review.html
