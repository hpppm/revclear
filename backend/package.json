{
  "name": "revclear-backend",
  "version": "1.0.0",
  "description": "RevClear Lambda functions for healthcare claims processing",
  "main": "index.js",
  "scripts": {
    "test": "cross-env npx jest --config jest.config.ts --verbose --passWithNoTests backend/tests",
    "build": "tsc",
    "build:watch": "tsc -w",
    "start": "node dist/start.js",
    "dev": "cross-env NODE_OPTIONS=--no-deprecation nodemon --watch 'src/**/*.ts' --exec 'npx ts-node --files' src/start.ts",
    "build:genkit": "tsc -p genkit/tsconfig.json",
    "depcheck": "depcheck"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.400.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.935.0",
    "@aws-sdk/client-dynamodb": "^3.400.0",
    "@aws-sdk/client-s3": "^3.400.0",
    "@aws-sdk/client-secrets-manager": "^3.935.0",
    "@aws-sdk/client-transcribe": "^3.400.0",
    "@aws-sdk/lib-dynamodb": "^3.400.0",
    "@aws-sdk/s3-request-presigner": "^3.400.0",
    "@genkit-ai/google-genai": "^1.24.0",
    "@genkit-ai/next": "^1.24.0",
    "aws-jwt-verify": "^4.0.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^4.18.0",
    "genkit": "^1.24.0",
    "helmet": "^8.1.0",
    "jest-mock-extended": "^4.0.0",
    "jsonwebtoken": "^9.0.2",
    "jwks-rsa": "^3.2.0",
    "morgan": "^1.10.1",
    "multer": "^2.0.2",
    "pg": "^8.16.3",
    "zod": "^3.25.8"
  },
  "devDependencies": {
    "@jest/types": "^29.6.3",
    "@types/aws-lambda": "^8.10.130",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.0",
    "@types/jest": "^30.0.0",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.0.0",
    "@types/supertest": "^6.0.3",
    "cross-env": "^10.1.0",
    "depcheck": "^1.4.7",
    "eslint": "^8.50.0",
    "jest": "^29.7.0",
    "nodemon": "^3.1.11",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.0.0"
  }
}