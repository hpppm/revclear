env

# ===========================
# Environment Configuration
# ===========================
# Server Port
PORT=3005
NODE_ENV=development
# Logging level: debug | info | warn | error (default: debug in dev, info in prod)
LOG_LEVEL=debug
 
# ====================================
# AWS configuration
# ====================================
# General
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=xxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=xxxxxxxxxx
 
# Bucket
AWS_S3_BUCKET=xxxxxxx

# Cognito


AWS_USER_POOL_ID=xxxxxxxxxxxx
AWS_CLIENT_ID=xxxxxxxxx

 
# RDS
DB_HOST=xxxxxxxx
DB_PORT=xxxxxxxx
DB_USERNAME=xxxxxxx
DB_PASSWORD=xxxxxxxx
DB_DATABASE=xxxxxxxxx
#=====================================
# GENKIT Credentials
#=====================================
GENKIT_ENV=dev
GOOGLE_API_KEY=xxxxxxxxxxxx
GENKIT_API_KEY=xxxxxxxxxxx

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b

ASSEMBLY_TRANSCRIPTION_API_KEY=xxxxxxxxxx
# Optional — flip to "true" once a HIPAA BAA is in place with AssemblyAI.
ASSEMBLYAI_MEDICAL_MODE=false
