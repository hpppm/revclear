# Public API URL — in Railway production this is /api (proxied server-side)
NEXT_PUBLIC_API_URL=http://localhost:3005/api

# Backend internal URL for server-side proxy (Railway private network in prod)
# BACKEND_INTERNAL_URL=http://backend.railway.internal:3005/api
