# =============================================================================
# RevClear Environment Variables
# Copy this file to .env and fill in the values
# =============================================================================

# -----------------------------------------------------------------------------
# General
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3005

# -----------------------------------------------------------------------------
# AWS Configuration
# -----------------------------------------------------------------------------
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=your-aws-account-id

# S3 Storage
AWS_S3_BUCKET=your-s3-bucket-name

# Cognito Authentication
AWS_COGNITO_USER_POOL_ID=your-user-pool-id
AWS_COGNITO_CLIENT_ID=your-client-id

# DynamoDB (optional, for dev testing)
AWS_DYNAMODB_TEST_TABLE=your-test-table-name

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
DATABASE_URL=
# Or individual connection params:
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=revclear
# DB_USER=your-db-user
# DB_PASSWORD=your-db-password

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------
# PHI Encryption Key (32 bytes hex encoded)
PHI_ENCRYPTION_KEY=your-32-byte-hex-key-here

# JWT Secret (for local token validation if not using Cognito)
JWT_SECRET=your-jwt-secret

# -----------------------------------------------------------------------------
# AI/ML Services
# -----------------------------------------------------------------------------
# Genkit Environment (dev/prod)
GENKIT_ENV=dev

# Google AI API Key (for Gemini)
GOOGLE_GENAI_API_KEY=your-google-ai-api-key

# Whisper transcription server (run backend/python/whisper_server.py)
AI_TRANSCRIBE_URL=http://localhost:5000/transcribe

# -----------------------------------------------------------------------------
# Analytics (optional)
# -----------------------------------------------------------------------------
API_ANALYTICS_KEY=your-analytics-key

# -----------------------------------------------------------------------------
# Frontend
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:3005/api
