@startuml Architecture_Overview

title RevClear - Multi-Tenant Healthcare System
caption ✅ DEPLOYED | AWS Account: 414669980881 | Region: us-east-1

scale max 2400 width
top to bottom direction

skinparam backgroundColor #FFFFFF
skinparam defaultFontSize 13

skinparam package {
  BackgroundColor<<live>> #E8F5E9
  BorderColor<<live>> #2E7D32
  BackgroundColor<<planned>> #E3F2FD
  BorderColor<<planned>> #1976D2
  BackgroundColor<<data>> #FFF9C4
  BorderColor<<data>> #F57F17
}

' === ACTORS ===
actor "Clinic A\nMental Health" as clinicA #81C784
actor "Clinic B\nPhysical Therapy" as clinicB #81C784
actor "Clinic C\nSpeech Therapy" as clinicC #81C784

' === AWS DEPLOYED ===
package "Auth - HIPAA Compliant" <<live>> {
  component "Cognito User Pool\nus-east-1_NZCFuSv1l" as cognito #90EE90
  component "Cognito Identity Pool\nus-east-1:1d234050..." as idpool #90EE90
  component "IAM Roles\nClinicA/B/C" as iam #90EE90
}

package "Frontend - Amplify" <<live>> {
  component "Next.js 16\nReact 19" as amplify #90EE90
}

package "Backend - Express API" <<live>> {
  component "Node.js\nPort 8080" as api #90EE90
}

package "Data Layer - Encrypted" <<data>> {
  database "DynamoDB\nmental_health_patients\nphysical_therapy_patients\nspeech_therapy_patients" as db #90EE90
  storage "S3 Bucket: arevclear\n/clinicA | /clinicB | /clinicC\n/ai | /logs | /raw | /exports" as s3 #90EE90
  component "KMS\nAES-256" as kms #90EE90
  component "CloudTrail\nAudit Logs" as trail #90EE90
}

' === PLANNED (Phase 2-4) ===
package "Planned Services" <<planned>> {
  component "WAF" as waf
  component "CloudFront" as cdn
  component "API Gateway" as apigw
  component "Lambda" as lambda
  component "Step Functions" as stepfn
  component "Transcribe Medical" as transcribe
  component "Bedrock Claude" as bedrock
  component "HealthLake" as healthlake
}

' === FLOWS ===
clinicA --> cognito : 1. Sign In
clinicB --> cognito : 1. Sign In
clinicC --> cognito : 1. Sign In
cognito --> idpool : 2. JWT Token
idpool --> iam : 3. Get IAM Role
iam --> amplify : 4. Access with Role
amplify --> api : 5. API Calls
api --> cognito : 6. Verify JWT
api --> db : 7. Tenant Data
api --> s3 : 8. Tenant Files
db --> kms : Encrypt
s3 --> kms : Encrypt
api --> trail : Audit

legend right
  **DEPLOYED INFRASTRUCTURE**
  ✅ Cognito: 3 groups (Clinic_A, B, C)
  ✅ IAM: 3 tenant roles with isolated access
  ✅ DynamoDB: 3 tables (1 per tenant)
  ✅ S3: arevclear bucket with tenant folders
  ✅ KMS: AES-256 encryption
  ✅ CloudTrail: Full audit logging
  
  **TENANT ISOLATION**
  Clinic A → mental_health_patients → /clinicA
  Clinic B → physical_therapy_patients → /clinicB  
  Clinic C → speech_therapy_patients → /clinicC
  
  **NEXT TO ADD**
  WAF → CloudFront → API Gateway → Lambda
  Step Functions → Transcribe → Bedrock → HealthLake
  
  **Cost:** ~$35/month
endlegend

@enduml
