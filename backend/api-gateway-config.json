{
  "comment": "API Gateway Configuration",
  "service": "AWS API Gateway",
  "type": "REST API",
  "authentication": "Cognito User Pool Authorizer",
  "cognitoUserPoolId": "${COGNITO_USER_POOL_ID}",
  "cognitoAppClientId": "${COGNITO_APP_CLIENT_ID}",
  "endpoints": [
    {
      "path": "/patients",
      "method": "GET",
      "lambda": "getPatients",
      "description": "List all patients for tenant"
    },
    {
      "path": "/encounters",
      "method": "POST",
      "lambda": "createEncounter",
      "description": "Create new encounter"
    },
    {
      "path": "/claims",
      "method": "POST",
      "lambda": "submitClaim",
      "description": "Submit insurance claim"
    },
    {
      "path": "/ai/transcribe",
      "method": "POST",
      "lambda": "transcribeAudio",
      "description": "Start audio transcription (A2I checkpoint 1)"
    },
    {
      "path": "/ai/summary",
      "method": "POST",
      "lambda": "generateSummary",
      "description": "Generate SOAP summary from transcript"
    },
    {
      "path": "/ai/codes",
      "method": "POST",
      "lambda": "generateCPTcodes",
      "description": "Generate ICD-10 and CPT codes (A2I checkpoint 2)"
    },
    {
      "path": "/ai/edi",
      "method": "POST",
      "lambda": "generateEDI",
      "description": "Generate EDI 837 claim file (A2I checkpoint 3)"
    },
    {
      "path": "/ai/analyze",
      "method": "POST",
      "lambda": "processWithBedrock",
      "description": "Risk scoring and similarity search"
    }
  ],
  "cors": {
    "enabled": true,
    "allowOrigins": ["https://YOUR_CLOUDFRONT_DOMAIN"],
    "allowMethods": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
    "allowHeaders": ["Content-Type", "Authorization"]
  }
}
