# =========================================
# RevClear — Root .env.example
# Copy backend/.env.example for backend vars
# Copy frontend/.env.example for frontend vars
# =========================================

# Top-level env vars used by docker-compose for local dev.
# For service-specific vars see backend/ and frontend/.

# Shared network name used by docker-compose.prod.yml
SHARED_DOCKER_NETWORK=revclear-shared

# Path to Let's Encrypt certs (self-hosted only, not needed on Railway/Cloudflare)
LETSENCRYPT_DIR=/etc/letsencrypt

# Backend env file location (used by docker-compose.prod.yml)
BACKEND_ENV_FILE=./backend/.env

# Public API URL passed to Next.js build
NEXT_PUBLIC_API_URL=/api
